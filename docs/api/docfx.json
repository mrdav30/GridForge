{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/GridForge/bin/Release/net10.0/GridForge.dll"],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "toc.yml"]
      },
      {
        "files": ["guides/**/*.md"]
      },
      {
        "files": ["**/*.yml"],
        "src": "obj/api",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": ["icon_128x128.png"],
        "src": "../../.assets",
        "dest": "assets"
      }
    ],
    "overwrite": [
      {
        "files": ["overrides/*.md"]
      }
    ],
    "output": "obj/_site",
    "template": ["default", "modern", "templates/gridforge"],
    "globalMetadata": {
      "_appName": "GridForge",
      "_appTitle": "GridForge documentation",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_appLogoPath": "assets/icon_128x128.png",
      "_appFaviconPath": "assets/icon_128x128.png"
    }
  }
}
