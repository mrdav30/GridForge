<Project>
  <PropertyGroup>
    <_GridForgeHostPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_GridForgeHostPlatform>
    <_GridForgeHostPlatform Condition="'$(_GridForgeHostPlatform)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">macos</_GridForgeHostPlatform>
    <_GridForgeHostPlatform Condition="'$(_GridForgeHostPlatform)' == ''">unix</_GridForgeHostPlatform>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/$(_GridForgeHostPlatform)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(MSBuildProjectExtensionsPath)' == '' And '$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">$(BaseIntermediateOutputPath)$(Configuration)/</MSBuildProjectExtensionsPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == '' And '$(TargetFramework)' != '' And '$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <!-- Preserve explicit local-stack ProjectReference configurations during solution builds. -->
    <ShouldUnsetParentConfigurationAndPlatform Condition="'$(UseLocalLsfStack)' == 'true'">false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLocalLsfStack)' == 'true'">
    <LocalLsfVersion>0.0.0-gf-local-lsf</LocalLsfVersion>
    <LocalLsfAssemblyVersion>0.0.0.0</LocalLsfAssemblyVersion>
    <LocalLsfChroniclerProperties>SemVer=0.0.0-chronicler-local-lsf;AssemblySemVer=$(LocalLsfAssemblyVersion)</LocalLsfChroniclerProperties>
    <LocalLsfFixedMathSharpProperties>SemVer=0.0.0-fms-local-lsf;AssemblySemVer=$(LocalLsfAssemblyVersion)</LocalLsfFixedMathSharpProperties>
    <LocalLsfSwiftCollectionsProperties>SemVer=0.0.0-sc-local-lsf;AssemblySemVer=$(LocalLsfAssemblyVersion)</LocalLsfSwiftCollectionsProperties>
    <LocalLsfGridForgeProperties>SemVer=$(LocalLsfVersion);AssemblySemVer=$(LocalLsfAssemblyVersion)</LocalLsfGridForgeProperties>
  </PropertyGroup>

  <!-- Runtime versions come from GitVersion in package mode and fixed identities in source mode. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'GridForge'">
    <SemVer Condition="'$(GitVersion_FullSemVer)' != ''">$(GitVersion_FullSemVer)</SemVer>
    <SemVer Condition="'$(UseLocalLsfStack)' == 'true'">$(LocalLsfVersion)</SemVer>
    <SemVer Condition="'$(SemVer)' == ''">0.0.0</SemVer>
    <InfoVer Condition="'$(GitVersion_InformationalVersion)' != ''">$(GitVersion_InformationalVersion)</InfoVer>
    <InfoVer Condition="'$(UseLocalLsfStack)' == 'true'">$(LocalLsfVersion)</InfoVer>
    <InfoVer Condition="'$(InfoVer)' == ''">$(SemVer)</InfoVer>
    <AssemblySemVer Condition="'$(GitVersion_AssemblySemVer)' != ''">$(GitVersion_AssemblySemVer)</AssemblySemVer>
    <AssemblySemVer Condition="'$(UseLocalLsfStack)' == 'true'">$(LocalLsfAssemblyVersion)</AssemblySemVer>
    <AssemblySemVer Condition="'$(AssemblySemVer)' == ''">$(SemVer).0</AssemblySemVer>
    <AssemblySemFileVer Condition="'$(GitVersion_AssemblySemFileVer)' != ''">$(GitVersion_AssemblySemFileVer)</AssemblySemFileVer>
    <AssemblySemFileVer Condition="'$(UseLocalLsfStack)' == 'true'">$(LocalLsfAssemblyVersion)</AssemblySemFileVer>
    <AssemblySemFileVer Condition="'$(AssemblySemFileVer)' == ''">$(AssemblySemVer)</AssemblySemFileVer>
    <InformationalVersion>$(InfoVer)</InformationalVersion>
    <Version>$(SemVer)</Version>
    <AssemblyVersion>$(AssemblySemVer)</AssemblyVersion>
    <FileVersion>$(AssemblySemFileVer)</FileVersion>
  </PropertyGroup>
</Project>
